{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/index.ts",
    "src/internal/*.ts",
    "src/cli/*.ts",
    "bin/*.mjs",
    ".claude/hooks/*.mjs"
  ],
  "project": ["src/**/*.ts", "bin/**/*.mjs", ".claude/hooks/**/*.mjs"],
  "ignoreDependencies": ["@commitlint/config-conventional", "@commitlint/types"]
}
