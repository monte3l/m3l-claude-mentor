{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/hooks/entry-*.ts",
    "src/cli/mentor-state.ts",
    "tests/**/*.test.ts",
    "bin/*.mjs",
    "scripts/*.mjs",
    ".claude/hooks/*.mjs"
  ],
  "project": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "bin/**/*.mjs",
    "scripts/**/*.mjs",
    ".claude/hooks/**/*.mjs"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["wrangler"],
  "ignoreDependencies": ["@commitlint/config-conventional", "@commitlint/types"]
}
